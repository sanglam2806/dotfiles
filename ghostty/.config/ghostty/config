theme = Kanagawabones

font-feature = "liga"
font-size = 15
font-style="Heavy"
font-variation-bold = wght=700
background-opacity = 0.8

background-blur-radius = 100
background-image = "./img/background.jpg" 
background-image-opacity = 0.1
background-image-fit = cover
macos-titlebar-proxy-icon = hidden

macos-titlebar-style = hidden
title = ""

# cursor-color = #c48270
cursor-opacity = 0.65 
adjust-cursor-thickness = 5
copy-on-select = clipboard

window-colorspace = "display-p3"
# fullscreen = true
window-width = 189
window-height = 53

bell-features = title
custom-shader = sampler2D iChannel0
# --- Background & text ---

#background = #f7f3d0
#foreground = #202020

cursor-color = #000000
cursor-text = #f6f1c3

selection-background = #bfa03a
selection-foreground = #bfa03a

